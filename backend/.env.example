# --- Splitwise OAuth app (https://www.splitwise.com/apps) ---
# Note: from Sept 1 2026 these credentials require an active Splitwise Pro
# subscription on the app owner's account, or they get disabled.
SPLITWISE_CLIENT_ID=
SPLITWISE_CLIENT_SECRET=
REDIRECT_URI=http://localhost:8080/login/callback

# --- Admin access ---
# Comma-separated Splitwise user ids allowed to reach /admin/stats,
# /admin/users and /admin/bugs. Those routes expose every user's name and
# email, so the list fails closed: leave it empty and nobody is an admin.
# Find your id with: db.users.findOne({ email: "you@example.com" }).splitwiseId
ADMIN_SPLITWISE_IDS=

# --- Session ---
# Days a login lasts before the user is bounced back through Splitwise OAuth.
SESSION_DAYS=30

# --- Core ---
MONGODB_URL=
FRONTEND_URL=http://localhost:3000
PORT=8080
NODE_ENV=development

# --- AWS / S3 receipt uploads ---
# These are the same two credentials under two different names: uploadToS3.js
# reads the *_ID pair while fileUploadRoutes.js reads the shorter pair. Both
# must be set until the naming is unified.
AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY_ID=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# --- Receipt parsing + email ---
OPENROUTER_API_KEY=
RESEND_API_KEY=
FROM_EMAIL=
EMAIL_SEND_DELAY_MS=
